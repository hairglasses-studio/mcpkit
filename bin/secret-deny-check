#!/usr/bin/env bash
# secret-deny-check — enforce secret deny patterns referencing NEVER-COMMIT.md, .gitignore, and .gitleaks.toml
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${1:-$(cd "$SCRIPT_DIR/.." && pwd)}"

ERRORS=0

echo "Checking secret deny patterns for repo: $REPO_ROOT"

# 1. Check for prohibited secret file patterns defined in NEVER-COMMIT.md and .gitignore
PROHIBITED_PATTERNS=(
  "*.pem"
  "*.key"
  "*.token"
  ".env"
  ".env.local"
  "id_rsa"
  "id_ed25519"
  "*.sync-conflict-*"
)

for pattern in "${PROHIBITED_PATTERNS[@]}"; do
  matches=""
  if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree &>/dev/null; then
    matches=$(git -C "$REPO_ROOT" ls-files "$pattern" 2>/dev/null || true)
  else
    matches=$(find "$REPO_ROOT" -maxdepth 3 -name "$pattern" -not -path "*/.git/*" 2>/dev/null || true)
  fi

  if [[ -n "$matches" ]]; then
    echo "ERROR: Found prohibited secret file matching pattern '$pattern': $matches" >&2
    ERRORS=$((ERRORS + 1))
  fi
done

# 2. Check for prohibited secret string tokens in repository files
if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree &>/dev/null; then
  raw_token_matches=$(git -C "$REPO_ROOT" grep -E -n \
    "sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_-]{30,}|AKIA[0-9A-Z]{16}" \
    -- ':!.gitleaks.toml' ':!NEVER-COMMIT.md' ':!AGENTS.md' || true)

  filtered_matches=""
  if [[ -n "$raw_token_matches" ]]; then
    filtered_matches=$(echo "$raw_token_matches" | grep -v "ghp_EXAMPLE_TOKEN_FOR_TESTING" | grep -v "github_pat_EXAMPLE_PAT_FOR_TESTING" | grep -v "AKIAIOSFODNN7EXAMPLE" | grep -v "AKIA1234567890ABCDEF" | grep -v "sk-abcdef0123456789abcdef" || true)
  fi

  if [[ -n "$filtered_matches" ]]; then
    echo "ERROR: Prohibited secret pattern found in codebase:" >&2
    echo "$filtered_matches" >&2
    ERRORS=$((ERRORS + 1))
  fi
fi

# 3. Run Gitleaks scan if the gitleaks binary is available
if command -v gitleaks &>/dev/null; then
  echo "Running Gitleaks scanner..."
  gitleaks_cmd=("gitleaks" "detect" "--source" "$REPO_ROOT" "--verbose")
  if [[ -f "$REPO_ROOT/.gitleaks.toml" ]]; then
    gitleaks_cmd+=("--config" "$REPO_ROOT/.gitleaks.toml")
  fi
  if ! "${gitleaks_cmd[@]}"; then
    echo "ERROR: Gitleaks scan detected secret leaks!" >&2
    ERRORS=$((ERRORS + 1))
  fi
else
  echo "Notice: gitleaks binary not found; skipped gitleaks pass (pattern check passed)."
fi

if [[ $ERRORS -gt 0 ]]; then
  echo "Secret deny pattern check failed with $ERRORS errors." >&2
  exit 1
fi

echo "Secret deny pattern check passed cleanly."
